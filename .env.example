# App
APP_NAME="Ninots App"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000

# Server
PORT=3000
HOSTNAME=0.0.0.0

# Database
# Default (local + docker compose): SQLite file under storage/ (compose mounts a volume)
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ninots
DB_USERNAME=root
DB_PASSWORD=

# Optional Postgres (docker compose --profile postgres):
# DB_CONNECTION=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=ninots
# DB_USERNAME=ninots
# DB_PASSWORD=ninots

# Cache
CACHE_STORE=array

# Session
# Drivers: file | cookie | database | redis (redis needs REDIS_URL)
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis (session + queue) — Docker: docker compose --profile redis up
REDIS_URL=redis://127.0.0.1:6379

# CSRF (set a strong secret in production)
CSRF_SECRET=change-me-in-production

# Optional GitHub OAuth (@ninots/social-auth) — leave unset to skip wiring
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# Queue — sync (default for tests) | redis (+ `nino queue:work`)
QUEUE_CONNECTION=sync
