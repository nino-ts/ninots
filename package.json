{
    "name": "ninots-app",
    "version": "0.4.1",
    "private": true,
    "type": "module",
    "packageManager": "bun@1.3.14",
    "engines": {
        "bun": ">=1.3.0"
    },
    "bin": {
        "nino": "./nino"
    },
    "scripts": {
        "dev": "bun --hot ./nino serve",
        "start": "bun ./nino serve --prod",
        "build": "bun build --compile --bytecode ./nino --outfile ninots",
        "nino": "bun ./nino",
        "type-check": "tsc --noEmit",
        "verify:route-types": "bun run scripts/verify-route-types.ts",
        "docs:generate": "typedoc",
        "format": "bunx biome format --write .",
        "lint": "bunx biome check .",
        "lint:fix": "bunx biome check --write .",
        "lint:fix:unsafe": "bunx biome check --write --unsafe .",
        "test": "bun test"
    },
    "dependencies": {
        "@ninots/auth": "^0.0.2",
        "@ninots/cache": "^0.0.2",
        "@ninots/config": "^0.0.2",
        "@ninots/console": "^0.0.2",
        "@ninots/container": "^0.0.2",
        "@ninots/events": "^0.0.2",
        "@ninots/filesystem": "^0.0.2",
        "@ninots/foundation": "^0.0.2",
        "@ninots/http": "^0.0.2",
        "@ninots/logger": "^0.0.2",
        "@ninots/middleware": "^0.0.2",
        "@ninots/orm": "^0.0.2",
        "@ninots/routing": "^0.0.2",
        "@ninots/session": "^0.0.2",
        "@ninots/support": "^0.0.2",
        "@ninots/validation": "^0.0.2",
        "@ninots/view": "^0.0.2",
        "@ninots/websocket": "^0.0.2"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.4",
        "@types/bun": "^1.3.13",
        "typescript": "^6.0.3"
    }
}
